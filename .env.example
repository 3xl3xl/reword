HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/reword.db
# Single-user alternative to OAuth. Required for non-local binding without OAuth; minimum 32 characters.
# REWORD_API_TOKEN=
ALLOWED_HOSTS=localhost:3000,127.0.0.1:3000
# Comma-separated explicit browser origins, if required. Default rejects all Origin headers.
ALLOWED_ORIGINS=

# OAuth mode: set all three and leave REWORD_API_TOKEN unset.
# Use the exact issuer and trusted key URL from your provider.
# OAUTH_ISSUER=https://identity.example.com/
# OAUTH_RESOURCE_URL=https://reword.example.com/mcp
# OAUTH_JWKS_URL=https://identity.example.com/jwks
# Include the public hostname in ALLOWED_HOSTS when deploying.

# Hosted Postgres migration only; local npm run dev continues to use SQLite.
# DATABASE_URL=postgresql://...
